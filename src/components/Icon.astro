---
interface Props {
  name: "appearance" | "mail" | "repository" | "external" | "copy" | "check" | "nodes";
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  class="line-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "appearance" && (
    <>
      <circle cx="12" cy="12" r="7.5"></circle>
      <path d="M12 4.5v15a7.5 7.5 0 0 0 0-15Z"></path>
    </>
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="m4 7 8 6 8-6"></path>
    </>
  )}
  {name === "repository" && (
    <>
      <path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21.5Z"></path>
      <path d="M5 4.5v17M9 6h7M9 10h5"></path>
    </>
  )}
  {name === "external" && (
    <>
      <path d="M14 5h5v5M10 14l9-9"></path>
      <path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"></path>
    </>
  )}
  {name === "copy" && (
    <>
      <rect x="8" y="8" width="11" height="11" rx="1.5"></rect>
      <path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-10A1.5 1.5 0 0 0 3 5.5v10A1.5 1.5 0 0 0 4.5 17H8"></path>
    </>
  )}
  {name === "check" && <path d="m5 12 4.5 4.5L19 7"></path>}
  {name === "nodes" && (
    <>
      <circle cx="6" cy="12" r="2.25"></circle>
      <circle cx="18" cy="6" r="2.25"></circle>
      <circle cx="18" cy="18" r="2.25"></circle>
      <path d="m8 11 7.8-4M8 13l7.8 4"></path>
    </>
  )}
</svg>
