---
import avatar from "../assets/avatar.jpg";
import Icon from "./Icon.astro";

const email = "jiangjunyan20040728@gmail.com";
---

<aside class="profile" aria-label="Personal profile">
  <div class="portrait-frame">
    <img src={avatar.src} width="360" height="360" alt="Illustrated portrait of Junyan Jiang" />
    <span class="portrait-index" aria-hidden="true">JJ / 26</span>
  </div>

  <div class="profile-identity">
    <p class="eyebrow">Research profile</p>
    <h2>Junyan Jiang</h2>
    <p class="role">Ph.D. Student<br />Software Security</p>
  </div>

  <div class="profile-meta">
    <p>IIE, Chinese Academy of Sciences</p>
    <p>Beijing, China</p>
  </div>

  <nav class="profile-links" aria-label="Contact links">
    <div class="profile-link email-row">
      <span class="link-content">
        <Icon name="mail" size={14} />
        <span>Email</span>
      </span>
      <button
        class="copy-button"
        type="button"
        data-copy-email={email}
        aria-label={`Copy email address ${email}`}
        title="Copy email address"
      >
        <span data-copy-label>Copy</span>
        <span class="copy-state" aria-hidden="true">
          <span class="copy-default"><Icon name="copy" size={13} /></span>
          <span class="copy-success"><Icon name="check" size={13} /></span>
        </span>
        <span class="sr-only" data-copy-feedback aria-live="polite">Copy email address</span>
      </button>
    </div>
    <a class="profile-link" href="https://github.com/jiuhao47" rel="me">
      <span class="link-content"><Icon name="repository" size={14} /> GitHub</span>
      <Icon name="external" size={13} />
    </a>
  </nav>

  <div class="availability">
    <Icon name="nodes" size={14} />
    <p>Open to research collaboration</p>
  </div>
</aside>
